<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>ClientFlow CRM</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f7fb;
    color: #172033;
}

/* ================= SIDEBAR ================= */

.sidebar {
    width: 230px;
    height: 100vh;
    background: #111827;
    color: white;
    position: fixed;
    left: 0;
    top: 0;
    padding: 25px 15px;
}

.logo {
    font-size: 22px;
    font-weight: bold;
    padding: 0 12px 30px;
}

.logo span {
    color: #7c83ff;
}

.menu button {
    width: 100%;
    border: none;
    background: transparent;
    color: #b8c0ce;
    padding: 13px 14px;
    margin-bottom: 5px;
    border-radius: 9px;
    text-align: left;
    cursor: pointer;
    font-size: 14px;
}

.menu button:hover,
.menu button.active {
    background: #252d3d;
    color: white;
}

/* ================= MAIN ================= */

.main {
    margin-left: 230px;
    padding: 30px;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.header h1 {
    margin: 0;
    font-size: 27px;
}

.header p {
    margin: 6px 0 0;
    color: #737d90;
    font-size: 14px;
}

.btn {
    background: #4f46e5;
    color: white;
    border: none;
    padding: 11px 17px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
}

.btn:hover {
    background: #4338ca;
}

/* ================= DASHBOARD CARDS ================= */

.cards {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 15px;
    margin-bottom: 25px;
}

.card {
    background: white;
    border: 1px solid #e5e8ef;
    border-radius: 13px;
    padding: 18px;
    box-shadow: 0 5px 20px rgba(0,0,0,0.04);
}

.card-title {
    color: #737d90;
    font-size: 12px;
}

.card-number {
    font-size: 27px;
    font-weight: bold;
    margin-top: 8px;
}

/* ================= CONTENT ================= */

.content {
    background: white;
    border: 1px solid #e5e8ef;
    border-radius: 13px;
    overflow: hidden;
}

.toolbar {
    padding: 16px;
    border-bottom: 1px solid #e5e8ef;
    display: flex;
    gap: 10px;
}

.search {
    width: 300px;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 8px;
}

.select {
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 8px;
    background: white;
}

/* ================= TABLE ================= */

table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    padding: 14px 17px;
    border-bottom: 1px solid #edf0f4;
    text-align: left;
    font-size: 13px;
}

th {
    color: #737d90;
    font-size: 11px;
    text-transform: uppercase;
}

.customer-name {
    font-weight: bold;
}

.small {
    color: #737d90;
    font-size: 11px;
    margin-top: 4px;
}

/* ================= STATUS ================= */

.status {
    display: inline-block;
    padding: 5px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: bold;
}

.New {
    background: #eef2ff;
    color: #4f46e5;
}

.Contacted {
    background: #f0f3f6;
    color: #536174;
}

.Pending,
.DocumentPending {
    background: #fff5df;
    color: #b76b00;
}

.Review,
.UnderReview {
    background: #eaf6ff;
    color: #1475aa;
}

.Approved {
    background: #e8f8f0;
    color: #12805e;
}

.Rejected {
    background: #ffedef;
    color: #c12f3e;
}

.Disbursed {
    background: #e5f8ef;
    color: #08774e;
}

/* ================= MODAL ================= */

.modal {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.45);
    justify-content: center;
    align-items: center;
    padding: 20px;
    z-index: 100;
}

.modal.show {
    display: flex;
}

.modal-box {
    background: white;
    width: 720px;
    max-width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 25px;
    border-radius: 15px;
}

.modal-box h2 {
    margin-top: 0;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 15px;
}

.form-group label {
    display: block;
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 6px;
}

.form-group input,
.form-group select,
.form-group textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #dce1e8;
    border-radius: 8px;
    font-size: 14px;
}

.form-group textarea {
    min-height: 90px;
}

.full {
    grid-column: 1 / -1;
}

.modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 20px;
}

.cancel {
    background: #eef0f4;
    color: #333;
}

/* ================= PROFILE ================= */

.profile {
    display: none;
}

.profile.active {
    display: block;
}

.back {
    border: none;
    background: transparent;
    color: #4f46e5;
    font-weight: bold;
    cursor: pointer;
    margin-bottom: 15px;
}

.profile-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.section {
    background: white;
    border: 1px solid #e5e8ef;
    border-radius: 13px;
    padding: 20px;
    margin-bottom: 16px;
}

.section h3 {
    margin-top: 0;
}

.details {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 10px;
    font-size: 13px;
}

.details b {
    color: #737d90;
}

.timeline {
    border-left: 2px solid #e4e7ec;
    padding-left: 20px;
    margin-left: 5px;
}

.timeline-item {
    margin-bottom: 20px;
    position: relative;
}

.timeline-item:before {
    content: "";
    position: absolute;
    width: 9px;
    height: 9px;
    background: #4f46e5;
    border-radius: 50%;
    left: -26px;
    top: 4px;
}

.application-card {
    border: 1px solid #e3e7ee;
    border-radius: 10px;
    padding: 15px;
    margin-top: 12px;
    background: #fafbff;
}

.application-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.application-info {
    display: flex;
    gap: 30px;
    margin-top: 15px;
    font-size: 13px;
}

.application-info div {
    min-width: 100px;
}

.application-info small {
    color: #737d90;
}

/* ================= RESPONSIVE ================= */

@media(max-width: 950px) {

    .cards {
        grid-template-columns: repeat(2, 1fr);
    }

}

@media(max-width: 700px) {

    .sidebar {
        width: 65px;
    }

    .logo {
        font-size: 0;
    }

    .logo span {
        font-size: 20px;
    }

    .menu button {
        font-size: 0;
        text-align: center;
    }

    .main {
        margin-left: 65px;
        padding: 18px;
    }

    .form-grid,
    .profile-grid {
        grid-template-columns: 1fr;
    }

    .cards {
        grid-template-columns: 1fr 1fr;
    }

    .toolbar {
        flex-direction: column;
    }

    .search {
        width: 100%;
    }

}
</style>
</head>


<body>

<!-- ================= SIDEBAR ================= -->

<div class="sidebar">

    <div class="logo">
        Client<span>Flow</span>
    </div>

    <div class="menu">

        <button class="active" onclick="dashboardPage(this)">
            📊 Dashboard
        </button>

        <button onclick="customersPage(this)">
            👥 Customers
        </button>

        <button onclick="loanTypesPage(this)">
            💰 Loan Types
        </button>

        <button onclick="applicationsPage(this)">
            📄 Applications
        </button>

        <button onclick="followupPage(this)">
            📅 Follow Up
        </button>

        <button onclick="reportsPage(this)">
            📈 Reports
        </button>

    </div>

</div>


<!-- ================= MAIN ================= -->

<div class="main">

<!-- DASHBOARD -->

<div id="dashboardPage">

    <div class="header">

        <div>
            <h1>Dashboard</h1>
            <p>Client overview and application progress</p>
        </div>

        <button class="btn" onclick="openCustomerModal()">
            + Add Customer
        </button>

    </div>


    <div class="cards">

        <div class="card">
            <div class="card-title">TOTAL CUSTOMERS</div>
            <div class="card-number" id="totalCustomers">0</div>
        </div>

        <div class="card">
            <div class="card-title">NEW LEADS</div>
            <div class="card-number" id="newLeads">0</div>
        </div>

        <div class="card">
            <div class="card-title">PENDING DOCUMENTS</div>
            <div class="card-number" id="pendingDocs">0</div>
        </div>

        <div class="card">
            <div class="card-title">APPROVED</div>
            <div class="card-number" id="approved">0</div>
        </div>

        <div class="card">
            <div class="card-title">DISBURSED</div>
            <div class="card-number" id="disbursed">0</div>
        </div>

    </div>


    <div class="content">

        <div class="toolbar">

            <input
                class="search"
                id="search"
                placeholder="Search customer name / phone..."
                oninput="renderCustomers()"
            >

            <select
                class="select"
                id="statusFilter"
                onchange="renderCustomers()"
            >

                <option value="">All Status</option>
                <option>New</option>
                <option>Contacted</option>
                <option>Pending</option>
                <option>Review</option>
                <option>Approved</option>
                <option>Rejected</option>
                <option>Disbursed</option>

            </select>

        </div>


        <table>

            <thead>

                <tr>
                    <th>Customer</th>
                    <th>Phone</th>
                    <th>Loan Type</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Updated</th>
                    <th></th>
                </tr>

            </thead>

            <tbody id="customerTable"></tbody>

        </table>

    </div>

</div>


<!-- PROFILE -->

<div id="profilePage" class="profile"></div>

</div>


<!-- ================= CUSTOMER MODAL ================= -->

<div class="modal" id="customerModal">

<div class="modal-box">

<h2>Add Customer</h2>

<form id="customerForm">

<div class="form-grid">

<div class="form-group">
<label>Full Name</label>
<input id="customerName" required>
</div>

<div class="form-group">
<label>Phone</label>
<input id="customerPhone" required>
</div>

<div class="form-group">
<label>Email</label>
<input id="customerEmail">
</div>

<div class="form-group">
<label>IC / Passport</label>
<input id="customerIC">
</div>

<div class="form-group">
<label>Date of Birth</label>
<input id="customerDOB" type="date">
</div>

<div class="form-group">
<label>Occupation</label>
<input id="customerJob">
</div>

<div class="form-group">
<label>Company</label>
<input id="customerCompany">
</div>

<div class="form-group">
<label>Monthly Income (RM)</label>
<input id="customerIncome" type="number">
</div>

<div class="form-group">
<label>Loan Type</label>

<select id="customerLoanType">

<option>Personal Loan</option>
<option>Debt Consolidation</option>
<option>Housing Loan</option>
<option>Car Loan</option>
<option>Business Loan</option>
<option>Credit Card</option>
<option>Refinancing</option>
<option>Other</option>

</select>

</div>

<div class="form-group">
<label>Loan Amount (RM)</label>
<input id="customerAmount" type="number">
</div>

<div class="form-group">

<label>Status</label>

<select id="customerStatus">

<option>New</option>
<option>Contacted</option>
<option>Pending</option>
<option>Review</option>
<option>Approved</option>
<option>Rejected</option>
<option>Disbursed</option>

</select>

</div>

<div class="form-group full">

<label>Notes</label>

<textarea id="customerNotes"></textarea>

</div>

</div>


<div class="modal-actions">

<button
type="button"
class="btn cancel"
onclick="closeCustomerModal()">

Cancel

</button>

<button class="btn">

Save Customer

</button>

</div>

</form>

</div>

</div>


<!-- ================= APPLICATION MODAL ================= -->

<div class="modal" id="applicationModal">

<div class="modal-box">

<h2>Add Loan Application</h2>

<form id="applicationForm">

<div class="form-grid">

<div class="form-group">

<label>Customer</label>

<select id="applicationCustomer" required></select>

</div>


<div class="form-group">

<label>Loan Type</label>

<select id="applicationLoanType">

<option>Personal Loan</option>
<option>Debt Consolidation</option>
<option>Housing Loan</option>
<option>Car Loan</option>
<option>Business Loan</option>
<option>Credit Card</option>
<option>Refinancing</option>
<option>Other</option>

</select>

</div>


<div class="form-group">

<label>Loan Amount (RM)</label>

<input id="applicationAmount" type="number">

</div>


<div class="form-group">

<label>Tenure (Months)</label>

<input id="applicationTenure" type="number">

</div>


<div class="form-group">

<label>Bank / Lender</label>

<input id="applicationBank">

</div>


<div class="form-group">

<label>Interest Rate (%)</label>

<input id="applicationRate" type="number" step="0.01">

</div>


<div class="form-group">

<label>Monthly Instalment (RM)</label>

<input id="applicationInstalment" type="number">

</div>


<div class="form-group">

<label>Status</label>

<select id="applicationStatus">

<option>New</option>
<option>Submitted</option>
<option>Document Pending</option>
<option>Under Review</option>
<option>Approved</option>
<option>Rejected</option>
<option>Disbursed</option>

</select>

</div>


<div class="form-group">

<label>Application Date</label>

<input id="applicationDate" type="date">

</div>


<div class="form-group full">

<label>Notes</label>

<textarea id="applicationNotes"></textarea>

</div>

</div>


<div class="modal-actions">

<button
type="button"
class="btn cancel"
onclick="closeApplicationModal()">

Cancel

</button>

<button class="btn">

Save Application

</button>

</div>

</form>

</div>

</div>


<script>

/* =====================================================
   DATA
===================================================== */

let customers =
JSON.parse(localStorage.getItem("clientflow_customers")) || [

{
id: 1,
name: "Sample Customer",
phone: "012-3456789",
email: "customer@email.com",
ic: "880625-14-XXXX",
dob: "1988-06-25",
job: "Sales Manager",
company: "ABC Sdn Bhd",
income: 13500,
loanType: "Debt Consolidation",
amount: 50000,
status: "Review",
notes: "Customer submitted latest documents.",
updated: "14 Sep 2026",

events: [
["14 Sep 2026", "Latest documents submitted"],
["13 Sep 2026", "Follow-up call completed"],
["12 Sep 2026", "Application submitted"]
],

applications: []

}

];


/* =====================================================
   SAVE DATA
===================================================== */

function saveData() {

localStorage.setItem(
"clientflow_customers",
JSON.stringify(customers)
);

}


/* =====================================================
   DASHBOARD STATS
===================================================== */

function updateStats() {

document.getElementById("totalCustomers").innerText =
customers.length;

document.getElementById("newLeads").innerText =
customers.filter(c => c.status === "New").length;

document.getElementById("pendingDocs").innerText =
customers.filter(c => c.status === "Pending").length;

document.getElementById("approved").innerText =
customers.filter(c => c.status === "Approved").length;

document.getElementById("disbursed").innerText =
customers.filter(c => c.status === "Disbursed").length;

}


/* =====================================================
   RENDER CUSTOMERS
===================================================== */

function renderCustomers() {

updateStats();

let search =
document.getElementById("search").value.toLowerCase();

let filter =
document.getElementById("statusFilter").value;

let list =
customers.filter(c => {

let matchSearch =
(c.name + " " + c.phone)
.toLowerCase()
.includes(search);

let matchStatus =
!filter || c.status === filter;

return matchSearch && matchStatus;

});


let table =
document.getElementById("customerTable");

if (list.length === 0) {

table.innerHTML = `
<tr>
<td colspan="7" style="text-align:center;padding:40px">
No customers found.
</td>
</tr>
`;

return;

}


table.innerHTML = list.map(c => `

<tr>

<td>

<div class="customer-name">
${c.name}
</div>

<div class="small">
${c.company || ""}
</div>

</td>


<td>
${c.phone}
</td>


<td>
${c.loanType || "-"}
</td>


<td>
RM ${Number(c.amount || 0).toLocaleString()}
</td>


<td>

<span class="status ${c.status.replaceAll(" ","")}">

${c.status}

</span>

</td>


<td>
${c.updated || "-"}
</td>


<td>

<button
class="btn"
style="padding:7px 10px;font-size:11px"
onclick="openProfile(${c.id})">

View

</button>

</td>

</tr>

`).join("");

}


/* =====================================================
   NAVIGATION
===================================================== */

function hideAll() {

document.getElementById("dashboardPage").style.display = "none";

document.getElementById("profilePage").classList.remove("active");

}


function dashboardPage(btn) {

hideAll();

document.getElementById("dashboardPage").style.display = "block";

setActive(btn);

renderCustomers();

}


function customersPage(btn) {

dashboardPage(btn);

}


function setActive(btn) {

document.querySelectorAll(".menu button")
.forEach(b => b.classList.remove("active"));

btn.classList.add("active");

}


/* =====================================================
   ADD CUSTOMER
===================================================== */

function openCustomerModal() {

document.getElementById("customerModal")
.classList.add("show");

document.getElementById("customerForm").reset();

}


function closeCustomerModal() {

document.getElementById("customerModal")
.classList.remove("show");

}


document.getElementById("customerForm")
.addEventListener("submit", function(e) {

e.preventDefault();

let today =
new Date().toLocaleDateString(
"en-GB",
{
day:"2-digit",
month:"short",
year:"numeric"
}
);


let customer = {

id: Date.now(),

name:
document.getElementById("customerName").value,

phone:
document.getElementById("customerPhone").value,

email:
document.getElementById("customerEmail").value,

ic:
document.getElementById("customerIC").value,

dob:
document.getElementById("customerDOB").value,

job:
document.getElementById("customerJob").value,

company:
document.getElementById("customerCompany").value,

income:
document.getElementById("customerIncome").value,

loanType:
document.getElementById("customerLoanType").value,

amount:
document.getElementById("customerAmount").value,

status:
document.getElementById("customerStatus").value,

notes:
document.getElementById("customerNotes").value,

updated: today,

events: [
[
today,
"Customer profile created"
]
],

applications: []

};


customers.unshift(customer);

saveData();

closeCustomerModal();

renderCustomers();

});


/* =====================================================
   CUSTOMER PROFILE
===================================================== */

function openProfile(id) {

let c =
customers.find(x => x.id === id);

hideAll();

let page =
document.getElementById("profilePage");

page.classList.add("active");


page.innerHTML = `

<button
class="back"
onclick="dashboardPage(document.querySelector('.menu button'))">

← Back to Customers

</button>


<div class="header">

<div>

<h1>${c.name}</h1>

<p>
${c.phone}

&nbsp; · &nbsp;

<span class="status ${c.status.replaceAll(" ","")}">
${c.status}
</span>

</p>

</div>


<button
class="btn"
onclick="openApplicationModal(${c.id})">

+ Add Loan Application

</button>

</div>


<div class="profile-grid">


<div class="section">

<h3>Personal Information</h3>

<div class="details">

<b>Full Name</b>
<span>${c.name}</span>

<b>IC / Passport</b>
<span>${c.ic || "-"}</span>

<b>Date of Birth</b>
<span>${c.dob || "-"}</span>

<b>Phone</b>
<span>${c.phone}</span>

<b>Email</b>
<span>${c.email || "-"}</span>

</div>

</div>


<div class="section">

<h3>Employment & Financial</h3>

<div class="details">

<b>Company</b>
<span>${c.company || "-"}</span>

<b>Position</b>
<span>${c.job || "-"}</span>

<b>Monthly Income</b>
<span>
RM ${Number(c.income || 0).toLocaleString()}
</span>

<b>Loan Type</b>
<span>${c.loanType || "-"}</span>

<b>Loan Amount</b>
<span>
RM ${Number(c.amount || 0).toLocaleString()}
</span>

</div>

</div>

</div>


<div class="section">

<h3>Notes</h3>

<p>
${c.notes || "No notes yet."}
</p>

</div>


<div class="section">

<h3>Loan Applications</h3>

<div id="applications-${c.id}">

${renderApplications(c)}

</div>

</div>


<div class="section">

<h3>Update Timeline</h3>

<div class="timeline">

${(c.events || []).map(e => `

<div class="timeline-item">

<b>${e[1]}</b>

<br>

<small>${e[0]}</small>

</div>

`).join("")}

</div>

<br>

<button
class="btn"
onclick="addUpdate(${c.id})">

+ Add Update

</button>

</div>

`;

}


function renderApplications(c) {

if (!c.applications ||
c.applications.length === 0) {

return `
<p style="color:#737d90">
No loan applications yet.
</p>
`;

}


return c.applications.map(a => `

<div class="application-card">

<div class="application-header">

<div>

<b>${a.loanType}</b>

<div class="small">
${a.id} · ${a.bank || "Bank not assigned"}
</div>

</div>

<span class="status ${a.status.replaceAll(" ","")}">
${a.status}
</span>

</div>


<div class="application-info">

<div>

<small>Amount</small>

<br>

<b>
RM ${Number(a.amount || 0).toLocaleString()}
</b>

</div>


<div>

<small>Tenure</small>

<br>

${a.tenure || "-"} months

</div>


<div>

<small>Interest</small>

<br>

${a.rate || "-"}%

</div>


<div>

<small>Monthly</small>

<br>

RM ${Number(a.instalment || 0).toLocaleString()}

</div>

</div>

</div>

`).join("");

