/* =====================================================
   ADD UPDATE
===================================================== */

function addUpdate(id) {

let c =
customers.find(x => x.id === id);

let note =
prompt("Enter follow-up / update:");

if (!note) return;

let today =
new Date().toLocaleDateString(
"en-GB",
{
day:"2-digit",
month:"short",
year:"numeric"
}
);


c.events =
c.events || [];

c.events.unshift([
today,
note
]);

c.updated = today;

saveData();

openProfile(id);

}


/* =====================================================
   LOAN APPLICATION
===================================================== */

function openApplicationModal(customerId) {

let select =
document.getElementById("applicationCustomer");


select.innerHTML =
customers.map(c => `

<option value="${c.id}">
${c.name} — ${c.phone}
</option>

`).join("");


if (customerId) {

select.value = customerId;

}


document.getElementById("applicationDate").value =
new Date().toISOString().split("T")[0];


document.getElementById("applicationModal")
.classList.add("show");

}


function closeApplicationModal() {

document.getElementById("applicationModal")
.classList.remove("show");

}


document.getElementById("applicationForm")
.addEventListener("submit", function(e) {

e.preventDefault();


let customerId =
Number(
document.getElementById("applicationCustomer").value
);


let c =
customers.find(x => x.id === customerId);


let today =
new Date().toLocaleDateString(
"en-GB",
{
day:"2-digit",
month:"short",
year:"numeric"
}
);


let application = {

id: "APP" + Date.now(),

loanType:
document.getElementById("applicationLoanType").value,

amount:
document.getElementById("applicationAmount").value,

tenure:
document.getElementById("applicationTenure").value,

bank:
document.getElementById("applicationBank").value,

rate:
document.getElementById("applicationRate").value,

instalment:
document.getElementById("applicationInstalment").value,

status:
document.getElementById("applicationStatus").value,

date:
document.getElementById("applicationDate").value,

notes:
document.getElementById("applicationNotes").value,

updated: today

};


c.applications =
c.applications || [];

c.applications.unshift(application);


c.events =
c.events || [];

c.events.unshift([
today,
"New " + application.loanType + " application created"
]);


c.updated = today;

saveData();

closeApplicationModal();

openProfile(customerId);

});


